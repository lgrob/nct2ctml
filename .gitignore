# Modified by Kinderspital Zurich (Kispi) from the original
# nct2ctml, Copyright 2026 The University of Hong Kong, Apache-2.0.
# Retargeted from adult oncology in Hong Kong to paediatric oncology.
# See CHANGES.md for what differs.

results/*
*.log
__pycache__/*
*.pyc

# Local virtualenv
.venv/

# Pulled trial data - regenerable with `python main.py pull --all`
cache/

# Runtime logs
logs/

# COSMIC Cancer Gene Census - redistribution is restricted by the COSMIC
# licence. Kept locally for utils/get_gene_synonym_mapping.py (a one-time
# script, not used at runtime); never committed to this public fork.
ref/Census_gene_list.csv

# NCBI harvest cache - regenerable with utils/build_gene_synonyms.py
ref/.ncbi_gene_cache.json

# Build artefact of utils/build_gene_synonyms.py - identical to the adopted
# ref/synonym_to_gene_symbol.tsv, so tracking both would just duplicate it.
ref/synonym_to_gene_symbol.generated.tsv

# Transient hand-off queue: matchminer-admin POSTs these to the MatchMiner
# API and deletes them. Tracking them would just churn the history.
ctml/json/*
!ctml/json/.gitkeep

# Awaiting review - working state, not a record of anything yet.
ctml/pending/*
!ctml/pending/.gitkeep
ctml/needs-review/*
!ctml/needs-review/.gitkeep

# Derived query index (utils/build_trial_index.py). Rebuilt deterministically
# from ctml/json, so it is not tracked by default - but see CHANGES.md: if the
# index is cited by a patient report, ship it as a versioned release artefact
# with its manifest rather than regenerating it ad hoc.
index/

# Benchmark outputs (bench/benchmark_map.py --out). Regenerated per run;
# the scored summary is bench/report.json.
bench/output*/
